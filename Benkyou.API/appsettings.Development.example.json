{
  "_comment": "Template for local development settings. Copy this to appsettings.Development.json and adjust for your local machine.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=BenkyouDB;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Key": "YOUR_LOCAL_DEV_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "BenkyouAPI",
    "Audience": "BenkyouClient",
    "ExpiryMinutes": 120
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "Resend": {
    "ApiToken": "YOUR_RESEND_API_TOKEN",
    "SenderEmail": "onboarding@resend.dev",
    "SenderName": "Benkyou",
    "DevRedirectEmail": "admin@localhost"
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_TEST_SECRET_KEY",
    "PublishableKey": "YOUR_STRIPE_TEST_PUBLISHABLE_KEY",
    "WebhookSecret": "YOUR_STRIPE_TEST_WEBHOOK_SECRET",
    "Plans": {
      "Basic": "price_basic_test",
      "Professional": "price_professional_test",
      "Enterprise": "price_enterprise_test"
    },
    "SuccessUrl": "https://localhost:7278/tenant/dashboard",
    "CancelUrl": "https://localhost:7278/tenant/subscribe"
  },
  "GoogleAnalytics": {
    "MeasurementId": "G-TESTID123",
    "ApiSecret": "YOUR_GA_API_SECRET"
  },
  "Mixpanel": {
    "Token": "YOUR_MIXPANEL_TOKEN"
  },
  "OneSignal": {
    "AppId": "YOUR_ONESIGNAL_APP_ID",
    "ApiKey": "YOUR_ONESIGNAL_API_KEY"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  }
}
