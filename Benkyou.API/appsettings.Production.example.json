{
  "_comment": "Template for Production settings. Copy this to appsettings.Production.json and populate with your production credentials.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_PROD_DB_HOST; Database=YOUR_DB_NAME; User Id=YOUR_DB_USER; Password=YOUR_DB_PASSWORD; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Key": "YOUR_STRONG_PRODUCTION_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "BenkyouAPI",
    "Audience": "BenkyouClient",
    "ExpiryMinutes": 120
  },
  "Resend": {
    "ApiToken": "YOUR_RESEND_PRODUCTION_API_TOKEN",
    "SenderEmail": "onboarding@resend.dev",
    "SenderName": "Benkyou Support"
  },
  "Frontend": {
    "AllowedOrigins": [
      "https://your-production-app.runasp.net"
    ]
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_LIVE_OR_TEST_SECRET_KEY",
    "PublishableKey": "YOUR_STRIPE_LIVE_OR_TEST_PUBLISHABLE_KEY",
    "WebhookSecret": "YOUR_STRIPE_WEBHOOK_SECRET",
    "Plans": {
      "Basic": "price_basic_id",
      "Professional": "price_professional_id",
      "Enterprise": "price_enterprise_id"
    },
    "SuccessUrl": "https://your-production-app.runasp.net/tenant/dashboard",
    "CancelUrl": "https://your-production-app.runasp.net/tenant/subscribe"
  },
  "GoogleAnalytics": {
    "MeasurementId": "G-XXXXXXXXXX",
    "ApiSecret": "YOUR_GA_API_SECRET"
  },
  "Mixpanel": {
    "Token": "YOUR_MIXPANEL_TOKEN"
  },
  "OneSignal": {
    "AppId": "YOUR_ONESIGNAL_APP_ID",
    "ApiKey": "YOUR_ONESIGNAL_API_KEY"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  }
}
