{
  "_comment": "Base settings shared by all environments. Override sensitive values in appsettings.Development.json, appsettings.Production.json, or via Environment Variables.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BenkyouDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Key": "GENERATE_A_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS",
    "Issuer": "BenkyouAPI",
    "Audience": "BenkyouClient",
    "ExpiryMinutes": 120
  },
  "Resend": {
    "ApiToken": "YOUR_RESEND_API_TOKEN",
    "SenderEmail": "onboarding@resend.dev",
    "SenderName": "Benkyou Support"
  },
  "Frontend": {
    "AllowedOrigins": [
      "https://benkyou.runasp.net",
      "https://benkyoulearn.runasp.net",
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY",
    "PublishableKey": "YOUR_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "YOUR_STRIPE_WEBHOOK_SECRET",
    "Plans": {
      "Basic": "price_basic_placeholder",
      "Professional": "price_professional_placeholder",
      "Enterprise": "price_enterprise_placeholder"
    },
    "SuccessUrl": "https://localhost:7278/tenant/dashboard",
    "CancelUrl": "https://localhost:7278/tenant/subscribe"
  },
  "GoogleAnalytics": {
    "MeasurementId": "G-XXXXXXXXXX",
    "ApiSecret": "YOUR_GA_API_SECRET"
  },
  "Mixpanel": {
    "Token": "YOUR_MIXPANEL_TOKEN"
  },
  "OneSignal": {
    "AppId": "YOUR_ONESIGNAL_APP_ID",
    "ApiKey": "YOUR_ONESIGNAL_API_KEY"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  }
}