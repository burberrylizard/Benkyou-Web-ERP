# Benkyou Frontend Environment Variables Template
# Copy this file to .env, .env.development, or .env.production and set appropriate values.

# API Base URL (e.g., https://localhost:7278/api for local dev, or your production API URL)
VITE_API_URL=https://localhost:7278/api

# Application Metadata
VITE_APP_TITLE=Benkyou UI
VITE_APP_DESCRIPTION=Learning Management & ERP System
VITE_APP_VERSION=1.0.0
VITE_APP_THEME_COLOR=#4CAF50
VITE_APP_LOG_LEVEL=info

# Feature Flags & Telemetry (Optional)
VITE_APP_ENABLE_ANALYTICS=false
VITE_APP_ANALYTICS_ID=
VITE_APP_ENABLE_SENTRY=false
VITE_APP_SENTRY_DSN=
